include *.md
recursive-include docs *.md
recursive-include docs *.html
recursive-include docs *.css
recursive-include docs *.js
recursive-include docs *.svg
include LICENSE
include pyproject.toml

recursive-include src *.json
recursive-include src *.mat
recursive-include src *.csv
recursive-include src *.md
recursive-include src *.hdf5

# setuptools adds tests/test*.py and packaged .pyc files on its own, so these
# two excludes are needed. Nothing else needs excluding: no rule above pulls
# in dotfiles, Makefile, mkdocs.yml or microphonics/test_data, and an exclude
# that matches nothing prints a warning on every build.
recursive-exclude tests *
global-exclude *.pyc
